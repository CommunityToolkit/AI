<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <NoWarn>$(NoWarn);EXTEXP0019;MEDE0001</NoWarn>
    <NoWarn Condition="'$(EnableExperimentalOptIn)' == 'true'">$(NoWarn);CTDE0001</NoWarn>
    <ProviderAssetFramework Condition="'$(ProviderAssetFramework)' == ''">$(TargetFramework)</ProviderAssetFramework>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.DocumentExtraction.PdfPig" Version="1.0.0-preview.1" GeneratePathProperty="true" />
    <PackageReference Include="CommunityToolkit.DocumentExtraction.AzureContentUnderstanding" Version="1.0.0-preview.1" GeneratePathProperty="true" />
    <PackageReference Include="CommunityToolkit.DocumentExtraction.AzureDocumentIntelligence" Version="1.0.0-preview.1" GeneratePathProperty="true" />
    <PackageReference Include="CommunityToolkit.DocumentExtraction.Mistral" Version="1.0.0-preview.1" GeneratePathProperty="true" />
    <PackageReference Include="CommunityToolkit.DocumentExtraction.VisionLanguageModel" Version="1.0.0-preview.1" GeneratePathProperty="true" />
    <PackageReference Include="System.Text.Json" Version="11.0.0-rc.3.26522.148" />
    <Reference Include="CommunityToolkit.DocumentExtraction.PdfPig" HintPath="$(PkgCommunityToolkit_DocumentExtraction_PdfPig)/lib/$(ProviderAssetFramework)/CommunityToolkit.DocumentExtraction.PdfPig.dll" />
    <Reference Include="CommunityToolkit.DocumentExtraction.AzureContentUnderstanding" HintPath="$(PkgCommunityToolkit_DocumentExtraction_AzureContentUnderstanding)/lib/$(ProviderAssetFramework)/CommunityToolkit.DocumentExtraction.AzureContentUnderstanding.dll" />
    <Reference Include="CommunityToolkit.DocumentExtraction.AzureDocumentIntelligence" HintPath="$(PkgCommunityToolkit_DocumentExtraction_AzureDocumentIntelligence)/lib/$(ProviderAssetFramework)/CommunityToolkit.DocumentExtraction.AzureDocumentIntelligence.dll" />
    <Reference Include="CommunityToolkit.DocumentExtraction.Mistral" HintPath="$(PkgCommunityToolkit_DocumentExtraction_Mistral)/lib/$(ProviderAssetFramework)/CommunityToolkit.DocumentExtraction.Mistral.dll" />
    <Reference Include="CommunityToolkit.DocumentExtraction.VisionLanguageModel" HintPath="$(PkgCommunityToolkit_DocumentExtraction_VisionLanguageModel)/lib/$(ProviderAssetFramework)/CommunityToolkit.DocumentExtraction.VisionLanguageModel.dll" />
    <Compile Include="../../DocumentExtraction/test/PdfPig.UnitTests/PdfFixture.cs" Link="PdfFixture.cs" />
  </ItemGroup>
  <Target Name="SelectActualProviderAsset" AfterTargets="ResolvePackageAssets">
    <ItemGroup>
      <ResolvedCompileFileDefinitions Remove="@(ResolvedCompileFileDefinitions)" Condition="$([System.String]::Copy('%(ResolvedCompileFileDefinitions.NuGetPackageId)').StartsWith('CommunityToolkit.DocumentExtraction.'))" />
      <RuntimeCopyLocalItems Remove="@(RuntimeCopyLocalItems)" Condition="$([System.String]::Copy('%(RuntimeCopyLocalItems.NuGetPackageId)').StartsWith('CommunityToolkit.DocumentExtraction.'))" />
    </ItemGroup>
  </Target>
</Project>
