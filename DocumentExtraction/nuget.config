<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="dotnet-libraries" value="https://pkgs.dev.azure.com/dnceng/public/_packaging/dotnet-libraries/nuget/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
      <package pattern="Microsoft.Extensions.AI.Abstractions" />
    </packageSource>
    <packageSource key="dotnet-libraries">
      <package pattern="Microsoft.Extensions.AI.Abstractions" />
      <package pattern="Microsoft.Extensions.Documents.Abstractions" />
      <package pattern="Microsoft.Extensions.DocumentExtraction.Abstractions" />
    </packageSource>
  </packageSourceMapping>
</configuration>
