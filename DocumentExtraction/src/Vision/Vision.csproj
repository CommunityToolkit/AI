<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Version>1.0.0-preview.1</Version>
    <AssemblyName>CommunityToolkit.DocumentExtraction.Vision</AssemblyName>
    <RootNamespace>$(AssemblyName)</RootNamespace>
    <TargetFrameworks>net10.0;net8.0</TargetFrameworks>
    <Title>Microsoft.Extensions.AI vision document extraction provider</Title>
    <Description>Free-form and structured vision extraction using an IChatClient.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="PdfPig" />
    <PackageReference Include="Docnet.Core" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" />
    <InternalsVisibleTo Include="$(AssemblyName).UnitTests" />
  </ItemGroup>
</Project>
