<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />
  <PropertyGroup>
    <DocumentExtractionBuild>true</DocumentExtractionBuild>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Experimental Documents and Extraction dependency contracts. -->
    <NoWarn>$(NoWarn);EXTEXP0019;MEDE0001</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DocumentExtraction.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Documents.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" />
    <Compile Include="$(MSBuildThisFileDirectory)Shared/ProviderAdapterHelpers.cs" LinkBase="Shared" />
    <Compile Include="$(MSBuildThisFileDirectory)Shared/SectionHierarchy.cs" LinkBase="Shared" />
  </ItemGroup>
</Project>
