<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Version>1.0.0-preview.3</Version>
    <AssemblyName>CommunityToolkit.VectorData.InMemory</AssemblyName>
    <RootNamespace>$(AssemblyName)</RootNamespace>
    <TargetFrameworks>net10.0;net8.0;netstandard2.0;net462</TargetFrameworks>

    <Title>In-Memory provider for Microsoft.Extensions.VectorData</Title>
    <Description>In-Memory provider for Microsoft.Extensions.VectorData by the .NET Community Toolkit</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Numerics.Tensors" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CommunityToolkit.VectorData.InMemory.UnitTests" />
