<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Version>1.0.0</Version>
    <AssemblyName>CommunityToolkit.VectorData.SqlServer</AssemblyName>
    <RootNamespace>$(AssemblyName)</RootNamespace>
    <TargetFrameworks>net10.0;net8.0;netstandard2.0;net462</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <Title>SQL Server provider for Microsoft.Extensions.VectorData</Title>
    <Description>SQL Server provider for Microsoft.Extensions.VectorData</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" />
    <PackageReference Include="System.Text.Json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CommunityToolkit.VectorData.SqlServer.UnitTests" />
    <InternalsVisibleTo Include="CommunityToolkit.VectorData.SqlServer.ConformanceTests" />
  </ItemGroup>

</Project>
