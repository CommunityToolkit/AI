<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Version>1.0.0-preview.1</Version>
    <AssemblyName>CommunityToolkit.DataRetrieval.OnnxReranker</AssemblyName>
    <RootNamespace>$(AssemblyName)</RootNamespace>
    <TargetFrameworks>net10.0;net8.0</TargetFrameworks>

    <Title>ONNX cross-encoder re-ranking for DataRetrieval pipelines</Title>
    <Description>ONNX Runtime cross-encoder re-ranker implementing IReranker for high-quality, low-latency passage re-ranking without LLM API calls.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DataRetrieval.Abstractions" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Managed" />
    <PackageReference Include="Microsoft.ML.Tokenizers" />
    <PackageReference Include="System.Numerics.Tensors" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CommunityToolkit.DataRetrieval.OnnxReranker.UnitTests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>
</Project>
