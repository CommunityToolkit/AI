<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Version>1.0.0-preview.1</Version>
    <AssemblyName>CommunityToolkit.DocumentProcessing.PdfPig.OnnxLayoutAnalysis</AssemblyName>
    <RootNamespace>$(AssemblyName)</RootNamespace>
    <TargetFrameworks>net10.0;net8.0</TargetFrameworks>

    <Title>ONNX-based layout detection for PdfPig document processing</Title>
    <Description>ONNX Runtime layout detection models (RT-DETR, YOLO, configurable) that implement PdfPig's IPageSegmenter for intelligent document layout analysis.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Managed" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="UglyToad.PdfPig" />
    <PackageReference Include="UglyToad.PdfPig.Core" />
    <PackageReference Include="UglyToad.PdfPig.DocumentLayoutAnalysis" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CommunityToolkit.DocumentProcessing.PdfPig.OnnxLayoutAnalysis.UnitTests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>
</Project>
